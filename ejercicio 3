#include <iostream>
using namespace std;

int main() {
    int n, d, pares;
    cout << "Ingrese un numero: ";
    cin >> n;
    pares = 0;
    while (n > 0) {
        d = n % 10;
        if (d % 2 == 0) {
            pares++;
        }
        n = n / 10;
    }
    cout << "Digitos pares = " << pares << endl;
    return 0;
}
