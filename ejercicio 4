#include <iostream>
using namespace std;

int main() {
    int n, original, d, inv;
    cout << "Ingrese un numero: ";
    cin >> n;
    original = n;
    inv = 0;
    while (n > 0) {
        d = n % 10;
        inv = inv * 10 + d;
        n = n / 10;
    }
    if (inv == original) {
        cout << original << " es capicua" << endl;
    } else {
        cout << original << " no es capicua" << endl;
    }
    return 0;
}
